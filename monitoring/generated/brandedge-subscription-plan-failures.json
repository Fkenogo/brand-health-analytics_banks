{
  "displayName": "BrandEdge subscription plan failures",
  "documentation": {
    "content": "Subscription plan management backend is failing. Check callable deployment, permissions, and plan validation paths.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "BrandEdge subscription plan failures threshold",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/brandedge_subscription_plan_failures\" AND resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "enabled": true,
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
