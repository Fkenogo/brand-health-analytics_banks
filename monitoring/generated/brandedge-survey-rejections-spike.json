{
  "displayName": "BrandEdge survey rejection spike",
  "documentation": {
    "content": "Public survey rejection volume spiked. Review App Check, cooldown rules, and abuse patterns.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "BrandEdge survey rejection spike threshold",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/brandedge_survey_submission_rejections\" AND resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 15,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "enabled": true,
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
